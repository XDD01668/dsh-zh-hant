{
  "name": "@local/dsh-zh-hant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Invertibly converts visible Simplified Chinese in the DeepSeek Harness Web UI to Hong Kong Traditional Chinese.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "LICENSES",
    "src",
    "scripts",
    "vendor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
